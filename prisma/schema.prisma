// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  
  // 1. URL UTAMA (Untuk Aplikasi berjalan)
  // Gunakan variabel yang isinya "prisma+postgres://..."
  url       = env("PRISMA_DATABASE_URL") 
  
  // 2. DIRECT URL (Untuk npx prisma db push)
  // Gunakan variabel yang isinya "postgres://..."
  directUrl = env("POSTGRES_URL")
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  imageUrl    String?
  link        String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
}